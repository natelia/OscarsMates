<section class="password-reset py-10">
  <div class="container mx-auto px-4">
    <div class="mx-auto max-w-md">
      <h1 class="text-center text-2xl font-semibold text-slate-900">Reset Your Password</h1>

      <p class="mt-3 text-center text-sm text-slate-600">
        Enter the email you signed up with and we'll send you a reset link.
      </p>

      <%= form_with(url: password_reset_path, local: true, class: "mt-8 space-y-4") do |f| %>
        <div>
          <%= f.label :email %>
          <%= f.email_field :email, autofocus: true, required: true, class: "mt-2 w-full", placeholder: "Enter your email" %>
        </div>

        <div>
          <%= f.submit "Send Reset Link", class: "btn-oscar w-full" %>
        </div>
      <% end %>
    </div>
  </div>
</section>
