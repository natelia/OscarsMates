# Database backup configuration
# Path where database backups will be stored (defaults to ./backups if not set)
BACKUP_PATH=/path/to/backups

# Application port mapping (defaults to 3001 if not set)
# APP_PORT=3001

# Application host (for allowed hosts in production/development)
# APP_HOST=your-domain.example.com

# Secret key for production (generate with: openssl rand -hex 64)
# SECRET_KEY_BASE=your-secret-key-here

# Outgoing mail (SMTP) - required in production, see compose.production.yml.
# Take the host, port and credentials from your mail provider.
SMTP_ADDRESS=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-login
SMTP_PASSWORD=your-smtp-key
# Sender shown to recipients. Must be an address on your verified domain.
SMTP_FROM=OscarsMates <noreply@example.com>
# Where messages from the feedback form are delivered.
FEEDBACK_EMAIL=you@example.com
